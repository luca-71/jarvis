# Required API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FISH_API_KEY=your-fish-audio-api-key-here

# Optional: fallback provider, used ONLY when Anthropic reports the credit
# balance is exhausted. Anthropic is retried after JARVIS_LLM_RETRY_AFTER
# seconds (default 600), since topping up is the expected end of that state.
# Transient failures (429, network) are never failed over — they are retried.
#
# Leave empty and nothing changes: no key, no fallback, no routing.
#
# Before setting it, note what JARVIS sends a model: mail, calendar, notes,
# screenshots and webcam frames — assume the vendor behind the model below
# sees it. Setting this key is that consent, for the periods the fallback
# is active.
# OPENROUTER_API_KEY=
# Not OpenRouter's own "openrouter/free" auto-router: it picks at random
# across whatever free models are up, including ones with no business
# answering a conversational turn — one draw landed on a content-moderation
# classifier, which duly replied "User Safety: safe" to "buongiorno". A
# pinned model can still vanish or degrade with no warning of its own (this
# already happened twice — a "stealth" listing started failing under load,
# a named nvidia one was later retired from the catalog outright, 404ing) —
# check https://openrouter.ai/models if this one starts erroring.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# JARVIS_LLM_RETRY_AFTER=600

# Optional: which speech synthesiser to use.
#   auto  (default) — Fish Audio when its key is set, otherwise macOS voices
#   fish            — always Fish Audio
#   macos           — always the built-in macOS voices: free, offline, no key
#   none            — silent; replies appear as on-screen captions only
# TTS_BACKEND=auto

# Optional: which macOS voice to speak with (see `say -v ?`).
# Empty picks the best installed voice for SPEECH_LANG.
# MACOS_VOICE=Alice

# Optional: Fish Audio voice model (defaults to JARVIS MCU voice)
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Optional: Your name (JARVIS will address you by name)
# USER_NAME=Tony

# Optional: Path to an Obsidian vault for JARVIS to search (READ-ONLY).
# Unset, the vault features stay off. A vault is just a folder of Markdown
# files, so no plugin or REST bridge is needed.
# OBSIDIAN_VAULT=~/Documents/MyVault

# Optional: Specific Apple Calendar accounts to read (comma-separated emails)
# If not set, JARVIS reads ALL calendars from Apple Calendar
# CALENDAR_ACCOUNTS=you@gmail.com,work@company.com

# Optional: Whether to skip Claude CLI permission prompts on subprocess calls.
# Defaults to "true" because JARVIS is voice-driven and cannot respond to
# interactive permission prompts (they would silently hang the subprocess).
# Set to "false" to require explicit permission prompts — only useful when
# running JARVIS interactively in a Terminal you can see and respond to.
# JARVIS_SKIP_PERMISSIONS=true

# Optional: Override the auto-detected weather location.
# By default, JARVIS uses your public-IP location (via ipwho.is) and reports
# Fahrenheit. Set these to pin a specific location:
# WEATHER_LOCATION_LABEL=Austin, TX
# WEATHER_LATITUDE=30.2672
# WEATHER_LONGITUDE=-97.7431
# WEATHER_UNIT=fahrenheit  # or "celsius"

# Optional: EZVIZ camera. Unset, the camera features stay off.
#
# The serial is on the device label and is case-sensitive — use uppercase.
# EZVIZ_DEVICE_SERIAL=XX1234567
#
# The verification code is also on the label. It is the RTSP password and it
# decrypts the cloud stream, so it is needed for either route below.
# EZVIZ_VERIFY_CODE=ABCDEF
#
# Local route (preferred): the camera's address on your LAN. Reserve it in the
# router first — a DHCP lease that moves silently breaks the stream. Enable
# RTSP in the EZVIZ app under Settings > Network first.
# EZVIZ_CAMERA_HOST=192.168.1.50
# EZVIZ_RTSP_PORT=554
#
# Cloud route: register at open.ezviz.com to get these. NOT your account email
# and password — those authenticate only the mobile app's private API.
# EZVIZ_APP_KEY=your-ezviz-app-key
# EZVIZ_APP_SECRET=your-ezviz-app-secret
#
# Optional: bootstrap host, if your account is not on the global platform.
# EZVIZ_API_HOST=https://open.ezvizlife.com
